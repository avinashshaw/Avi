# Copy this file to ".env" and fill in your values.

# Port the app server listens on.
PORT=3000

# --- Shopify app credentials (required) ---
# From your app in the Shopify Partner Dashboard (Apps -> your app -> API access),
# or printed by `shopify app dev` when running locally.
SHOPIFY_API_KEY=your_app_client_id
SHOPIFY_API_SECRET=your_app_client_secret

# Comma-separated Admin API scopes the app requests at install time.
SCOPES=read_products,read_metaobjects,write_metaobjects

# Public HTTPS URL where this app is reachable (a tunnel URL during dev, e.g.
# from `shopify app dev`, or your production domain). No trailing slash.
SHOPIFY_APP_URL=https://your-tunnel-or-domain
