# Copy this file to ".env" and fill in your values.

# Port the local app server listens on.
PORT=3000

# --- Shopify Admin API (optional) ---
# Leave these blank to run in "local only" mode: reviews are saved to
# data/reviews.json and never pushed to Shopify. Fill them in to sync the
# imported reviews into Shopify as metaobjects.
#
# Create a custom app in your Shopify admin (Settings -> Apps and sales
# channels -> Develop apps) and grant these Admin API scopes:
#   read_metaobjects, write_metaobjects, read_products
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
