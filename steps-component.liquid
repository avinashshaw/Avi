    <div class="tyde-steps__row">

      <div class="tyde-steps__item">
        <div class="tyde-steps__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 1.5a5 5 0 00-3.54 1.46L3.96 12.96a5 5 0 107.08 7.08l10-10A5 5 0 0017.5 1.5zm-5 5.66l4.34 4.34-5.88 5.88-4.34-4.34 5.88-5.88z"/></svg>
        </div>
        <div class="tyde-steps__body">
