        </div>
      </div>

      <div class="tyde-steps__dash">
        <svg viewBox="0 0 140 3" preserveAspectRatio="none">
          <line x1="0" y1="1.5" x2="140" y2="1.5" stroke="#1A6B7C" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="10 10"/>
        </svg>
      </div>

      <div class="tyde-steps__item">
        <div class="tyde-steps__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-8-5.5-8-11.5a5.5 5.5 0 0110-3.2 5.5 5.5 0 0110 3.2C22 15.5 12 21 12 21z"/></svg>
        </div>
        <div class="tyde-steps__body">
          <p class="tyde-steps__title">Absorb</p>
          <p class="tyde-steps__desc">Premium natural ingredients go to work supporting energy, focus & balance.</p>
        </div>
      </div>

      <div class="tyde-steps__dash">
        <svg viewBox="0 0 140 3" preserveAspectRatio="none">
          <line x1="0" y1="1.5" x2="140" y2="1.5" stroke="#1A6B7C" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="10 10"/>
        </svg>
      </div>

      <div class="tyde-steps__item">
        <div class="tyde-steps__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H12L13 2z"/></svg>
        </div>
        <div class="tyde-steps__body">
          <p class="tyde-steps__title">Thrive</p>
          <p class="tyde-steps__desc">Feel confident, energized, and unstoppable, every single day.</p>
        </div>
      </div>

    </div>

    <div class="tyde-steps__btn-wrap">
      <a href="#product-form" class="tyde-steps__btn">
        Try Tyde <span class="tyde-steps__btn-accent">Risk-Free</span> Today
      </a>
      <div class="tyde-steps__shipping">
        <svg viewBox="0 0 32 32"><path d="M7.8 26.7c-1.1 0-2-.4-2.7-1.1-.8-.8-1.1-1.7-1.1-2.8H1.8V7.9c0-.5.2-1 .6-1.4.4-.4.8-.6 1.4-.6h18.8v5.4h3.4l4.4 5.9v5.6h-2.3c0 1.1-.4 2-1.1 2.8-.8.8-1.7 1.1-2.7 1.1s-2-.4-2.7-1.1c-.8-.8-1.1-1.7-1.1-2.8h-8.8c0 1.1-.4 2-1.1 2.7-.8.7-1.7 1.1-2.8 1.1z"/></svg>
        Free shipping on orders over $999*
      </div>
    </div>

  </div>
</section>
